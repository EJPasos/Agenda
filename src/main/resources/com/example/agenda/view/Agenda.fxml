<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.agenda.view.AgendaViewController">
    <children>
        <!-- PANEL IZQUIERDO: LISTA DE PERSONAS -->
        <VBox prefWidth="250.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <children>
                <Label text="Contactos" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </Label>
                <ListView fx:id="listaPersonas" VBox.vgrow="ALWAYS" />
                <Button fx:id="btnNuevaPersona" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleNuevaPersona" text="Añadir Persona">
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>

        <!-- PANEL DERECHO: CONTENEDOR DE ESTADOS -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff;">
            <children>

                <!-- ESTADO 1: PANEL DE BIENVENIDA (Vacío) -->
                <VBox fx:id="panelBienvenida" alignment="CENTER" visible="true">
                    <children>
                        <Label text="Agenda" textFill="#999999">
                            <font>
                                <Font size="36.0" />
                            </font>
                        </Label>
                        <Label text="Selecciona un contacto o añade uno nuevo" textFill="#999999" />
                    </children>
                </VBox>

                <!-- ESTADO 2: PANEL DE VISTA (Solo lectura) -->
                <VBox fx:id="panelVista" spacing="15.0" visible="false">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label fx:id="lblNombreVista" text="Nombre Apellido">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Dirección:" textFill="#666666" />
                        <Label fx:id="lblDireccionVista" text="Calle Falsa 123" wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label text="Teléfonos:" textFill="#666666">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <ListView fx:id="listaTelefonosVista" prefHeight="150.0" style="-fx-background-color: transparent;" />

                        <HBox spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleModificar" text="Modificar" />
                                <Button mnemonicParsing="false" onAction="#handleEliminar" style="-fx-text-fill: red;" text="Eliminar" />
                            </children>
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>

                <!-- ESTADO 3: PANEL DE EDICIÓN / ALTA -->
                <VBox fx:id="panelEdicion" spacing="10.0" visible="false">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label fx:id="lblTituloEdicion" text="Nueva Persona">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="Nombre:" />
                        <TextField fx:id="txtNombre" promptText="Ej. John Doe" />
                        <Label text="Dirección:" />
                        <TextField fx:id="txtDireccion" promptText="Ej. Calle Falsa 123" />

                        <Label text="Teléfonos:" />
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="txtNuevoTelefono" promptText="Número de teléfono" HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#handleAgregarTelefono" text="Agregar" />
                            </children>
                        </HBox>
                        <ListView fx:id="listaTelefonosEdicion" prefHeight="120.0" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
                                <Button mnemonicParsing="false" onAction="#handleGuardar" style="-fx-base: #2196F3;" text="Guardar" textFill="WHITE" />
                            </children>
                            <VBox.margin>
                                <Insets top="15.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </StackPane>
    </children>
</HBox>